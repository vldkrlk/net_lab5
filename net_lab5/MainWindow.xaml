<Window x:Class="net_lab5.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:net_lab5"
        mc:Ignorable="d"
        Title="Керування працівниками" Height="638" Width="1295"
        MinHeight="500" MinWidth="800">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="Додати працівника" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Label Grid.Column="0" Content="ПІБ:" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Margin="8,0,16,0" Height="26" x:Name="txtFullName"/>

                <Label Grid.Column="2" Content="Посада:" VerticalAlignment="Center" />
                <TextBox Grid.Column="3" Margin="8,0,16,0" Height="26" x:Name="txtPosition"/>

                <Label Grid.Column="4" Content="Зарплата:" VerticalAlignment="Center" />
                <TextBox Grid.Column="5" Margin="8,0,16,0" Height="26" x:Name="txtSalary"/>

                <Label Grid.Column="6" Content="Стаж:" VerticalAlignment="Center" />
                <TextBox Grid.Column="7" Margin="8,0,16,0" Height="26" x:Name="txtExperience"/>

                <Button Grid.Column="8" Content="Додати працівника" Height="30" MinWidth="110"
                        HorizontalAlignment="Right" Padding="12,0" Click="AddEmployee_Click" />
            </Grid>
        </GroupBox>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Label Content="Фільтр за зарплатою:" VerticalAlignment="Center" />
            <TextBox Width="120" Height="26" Margin="8,0,8,0" x:Name="txtFilterSalary"/>
            <Button Content="Фільтрувати за зарплатою" Height="28" Padding="12,0" Margin="0,0,8,0" Click="FilterBySalary_Click"/>
            <Button Content="Скинути фільтри" Height="28" Padding="12,0" Margin="0,0,24,0" Click="ResetFilters_Click"/>
            <Button Content="Сортувати за робочим стажем" Height="28" Padding="12,0" Margin="0,0,8,0" Click="SortByExp_Click"/>
            <Button Content="Видалити працівника" Height="28" Padding="12,0"
                    Click="DeleteEmployee_Click" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,0,0,0">
                <Button Content="Завантажити" Height="28" MinWidth="80" Padding="12,0" Margin="0,0,8,0"
                        x:Name="btnLoad" Click="BtnLoad_Click" />
                <Button Content="Зберегти" Height="28" MinWidth="80"
                        Padding="12,0" x:Name="btnSave" Click="BtnSave_Click" />
            </StackPanel>
        </StackPanel>

        <GroupBox Grid.Row="2" Header="Працівники" Padding="8">
            <DataGrid AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      SelectionMode="Single" HeadersVisibility="Column" x:Name="dataGridEmployees">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ПІБ" Width="*" Binding="{Binding FullName}" />
                    <DataGridTextColumn Header="Посада" Width="*" Binding="{Binding Position}" />
                    <DataGridTextColumn Header="Зарплата" Width="140" Binding="{Binding Salary}" />
                    <DataGridTextColumn Header="Стаж" Width="140" Binding="{Binding Experience}" />
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
    </Grid>
</Window>
